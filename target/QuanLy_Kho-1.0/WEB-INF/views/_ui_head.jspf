<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
body { font-family: 'Inter', sans-serif; background-color: #f7f9fb; }
.material-symbols-outlined {
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}
/* ===== vieclass giữ lại từ giao diện cũ (chỉ các yếu tố JS cần) ===== */
/* live dot realtime (WS) */
.live-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #cbd5e1; display: inline-block; flex-shrink: 0;
}
.live-dot.on { background: #10b981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18); }
/* backdrop mobile sidebar */
.sidebar-backdrop { display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.45); z-index: 30; }
.sidebar-backdrop.show { display: block; }
/* mobile sidebar mở khi toggle `.open` (sidebar dùng hidden md:flex) */
#sidebar.open { display: flex; }
/* bảng cuộn ngang trên mobile */
.table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.table-scroll table { min-width: 560px; }
/* ảnh sản phẩm trong bảng */
.img-cell { display: flex; align-items: center; gap: 12px; }
.img-pop { width: 32px; height: 32px; border-radius: 6px; object-fit: cover; border: 1px solid #dfe4e9; flex-shrink: 0; }
/* form inline trong bảng */
.inline-form { display: inline; }
/* giảm chuyển động */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
}
</style>
